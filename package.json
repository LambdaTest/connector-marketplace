{
  "name": "connector-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Listings, schema and checks for the connector marketplace.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.js",
    "build": "node scripts/build-catalog.js",
    "check:logos": "node scripts/check-logos.js",
    "check:secrets": "node scripts/scan-secrets.js",
    "check:links": "node scripts/check-links.js",
    "check": "npm run validate && npm run check:logos && npm run check:secrets",
    "test": "node --test tests/",
    "build:site": "node scripts/build-site.js",
    "build:ratings": "node scripts/build-ratings.js --out dist/site/ratings.json",
    "check:health": "node scripts/check-health.js --out dist/site/health.json --previous dist/site/health.json",
    "serve": "npm run build:site && npm run build:ratings && npm run check:health && npx --yes http-server@14 dist/site -p 8080 -c-1"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "marked": "18.1.2",
    "yaml": "^2.5.1"
  }
}
